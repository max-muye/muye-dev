{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icy-surf-f3ab",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "API_LAMBDA",
      "service": "api-lambda"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
